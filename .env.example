ENVIRONMENT=staging

# Backend
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/cwscx
AUTH_MODE=entra
CORS_ALLOW_ORIGINS=https://cwscx-tst01.cwsey.com
CORS_ALLOW_ORIGIN_REGEX=
LOG_LEVEL=INFO

# Entra (backend token validation)
ENTRA_TENANT_ID=97df7dc2-f178-4ce4-b55e-bcafc144485e
ENTRA_CLIENT_ID=7e09a8c1-f113-4e3f-aeb7-21d1305cbd55
ENTRA_AUTHORITY=https://login.microsoftonline.com/${ENTRA_TENANT_ID}
ENTRA_ISSUER=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
ENTRA_AUDIENCE=api://${ENTRA_CLIENT_ID}
ENTRA_JWKS_URL=
ENTRA_DEBUG=false

# Frontend build-time vars (set per app before npm run build)
VITE_API_URL=/api
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/${VITE_ENTRA_TENANT_ID}
VITE_ENTRA_API_SCOPE=api://${VITE_ENTRA_CLIENT_ID}/access_as_user
VITE_AUTH_MODE=entra

# Vite base path per deployed app
# mystery-shopper: /
# dashboard: /dashboard/
# surveys (b2b): /surveys/b2b/
# surveys (installation): /surveys/installation/
VITE_BASE_PATH=/

# Mystery public DMZ only
MYSTERY_AUTH_SECRET_KEY=
MYSTERY_SESSION_IDLE_MINUTES=45
MYSTERY_SESSION_ABSOLUTE_HOURS=10
MYSTERY_MFA_CHALLENGE_MINUTES=5
MYSTERY_ENROLL_TOKEN_MINUTES=30

# Public URL of the mystery shopper SPA (no trailing slash).
# Required on the INTERNAL backend (AUTH_MODE=entra) so the dashboard's
# Mystery Shopper Users admin page returns full enrollment links
# (e.g. https://<dmz-host>/?enroll=<token>). Without it only the raw
# token is shown. Optional on the DMZ backend.
MYSTERY_PUBLIC_BASE_URL=

# SMTP (report emails + mystery shopper enrollment emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
SMTP_USE_SSL=
