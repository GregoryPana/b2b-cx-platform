[Unit]
Description=__APP_NAME__ FastAPI Backend
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_ROOT__/backend
EnvironmentFile=__APP_ROOT__/.env
ExecStart=__APP_ROOT__/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
