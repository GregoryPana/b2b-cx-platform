ENVIRONMENT=staging

# Backend
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5433/<database>
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=https://<host>

# Entra backend validation
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUTHORITY=https://login.microsoftonline.com/${ENTRA_TENANT_ID}
